// ===================== ARDUINO INITIALIZATION =====================
void setup() {
  Wire.begin(D1, D2);
  pinMode(UP_BUTTON, INPUT_PULLUP);
  pinMode(DOWN_BUTTON, INPUT_PULLUP);
  pinMode(OK_BUTTON, INPUT_PULLUP);
  pinMode(LEFT_BUTTON, INPUT_PULLUP);
  pinMode(RIGHT_BUTTON, INPUT_PULLUP);

  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.setTextColor(SSD1306_WHITE);
  display.clearDisplay();
  
  // Initialize EEPROM and read the index of the next boot image
  EEPROM.begin(4);
  int selectedBitmap = EEPROM.read(0);
  if (selectedBitmap >= num_boot_bitmaps) {
    selectedBitmap = 0;
  }
  display.drawBitmap(0, 0, boot_bitmaps[selectedBitmap], 128, 64, SSD1306_WHITE);
  display.display();

  // Save the next boot image index (sequential / series-wise)
  EEPROM.write(0, (selectedBitmap + 1) % num_boot_bitmaps);
  EEPROM.commit();
  delay(1000);
}

void loop() {
  if (!unlocked) {
    handlePassword();
    return;
  }

  if (!inGame) {
    drawMenu();
    handleMenuInput();
  } else {
    showSelectedGame();
  }
}

void handlePassword() {
  static int lastRead = HIGH;
  int currentButton = readButton();

  if (currentButton != -1 && lastRead == HIGH) {
    if (currentButton == passwordSequence[passwordIndex]) {
      passwordIndex++;
      if (passwordIndex >= passwordLength) {
        unlocked = true;
        // Silent unlock directly to the game menu
        display.clearDisplay();
        display.display();
        delay(200);
      }
    } else {
      passwordIndex = 0;
    }
  }

  lastRead = (currentButton == -1) ? HIGH : LOW;
}

int readButton() {
  if (digitalRead(UP_BUTTON) == LOW) return UP_BUTTON;
  if (digitalRead(DOWN_BUTTON) == LOW) return DOWN_BUTTON;
  if (digitalRead(OK_BUTTON) == LOW) return OK_BUTTON;
  return -1;
}

void drawMenu() {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("Select Game:");
  for (int i = 0; i < 6; i++) {
    int index = menuStartIndex + i;
    if (index >= totalGames) break;
    if (index == selectedGame) display.print("> ");
    else display.print("  ");
    display.println(games[index]);
  }
  display.display();
}

void handleMenuInput() {
  if (millis() - lastDebounce > 200) {
    if (digitalRead(UP_BUTTON) == LOW) {
      selectedGame = (selectedGame - 1 + totalGames) % totalGames;
      lastDebounce = millis();
    }
    if (digitalRead(DOWN_BUTTON) == LOW) {
      selectedGame = (selectedGame + 1) % totalGames;
      lastDebounce = millis();
    }
    if (digitalRead(OK_BUTTON) == LOW) {
      inGame = true;
      lastDebounce = millis();
    }

    if (selectedGame < menuStartIndex) menuStartIndex = selectedGame;
    else if (selectedGame >= menuStartIndex + 6) menuStartIndex = selectedGame - 5;
  }
}

void showSelectedGame() {
  switch (selectedGame) {
    case 0: dinoRun(); break;
    case 1: snakeGame(); break;
    case 2: flappystone(); break;
    case 3: ticTacToe(); break;
    case 4: pongGame(); break;
    case 5: marioMiniGame(); break;
    case 6: carDodgerGame(); break;
    case 7: tappyTapGame(); break;
    case 8: spaceInvaderGame(); break;
    case 9: tetrislite(); break;
    case 10: brickkillerGame(); break;
    case 11: play2048(); break;
    case 12: playDoodleJump(); break;
    case 13: mazeSolverGame(); break;
    case 14: pacmanGame(); break;
    case 15: froggerGame(); break;
    case 16: helicopterGame(); break;
    default: inGame = false; break;
  }
}

void gameOver(int score) {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(2);
  display.setCursor(10, 15);
  display.println("Game Over!");
  display.setTextSize(1);
  display.setCursor(20, 40);
  display.print("Score: ");
  display.print(score);
  display.display();
  delay(2000);
}

// ===================== GAME 1: DINO RUN =====================
void dinoRun() {
  float dinoY = 42;
  float velocity = 0;
  
  float gravity = 0.55;
  float jump = -5.8; 
  
  float obsX = SCREEN_WIDTH;
  int obsType = 0; 
  int obsW = 6;
  int obsH = 12;
  int obsY = 42;
  
  int score = 0;
  float speed = 3.0;
  
  float starX[3] = {30, 80, 120};
  int starY[3] = {10, 22, 15};
  float cloudX = 90;
  int cloudY = 8;
  
  bool running = true;
  bool animFrame = false;
  unsigned long animTimer = 0;

  while(digitalRead(OK_BUTTON) == LOW || digitalRead(UP_BUTTON) == LOW) delay(10);

  while (running) {
    bool isJumping = (digitalRead(OK_BUTTON) == LOW || digitalRead(UP_BUTTON) == LOW);
    bool isDucking = (digitalRead(DOWN_BUTTON) == LOW && dinoY >= 42);

    if (isJumping && dinoY >= 42) {
      velocity = jump;
    }

    velocity += gravity;
    dinoY += velocity;

    if (dinoY > 42) {
      dinoY = 42;
      velocity = 0;
    }

    if (millis() - animTimer > 100) {
      animFrame = !animFrame;
      animTimer = millis();
    }

    speed = 3.0 + (score / 12.0);
    if (speed > 7.5) speed = 7.5;

    obsX -= speed;
    if (obsX < -16) {
      obsX = SCREEN_WIDTH + random(30, 70); 
      obsType = random(0, 4);
      if (obsType == 0) { obsW = 6; obsH = 12; obsY = 42; }
      else if (obsType == 1) { obsW = 12; obsH = 12; obsY = 42; }
      else if (obsType == 2) { obsW = 8; obsH = 8; obsY = 28; } 
      else { obsW = 8; obsH = 8; obsY = 44; } 
      score++;
    }

    for (int i = 0; i < 3; i++) {
      starX[i] -= speed * 0.3;
      if (starX[i] < 0) { starX[i] = SCREEN_WIDTH; starY[i] = random(5, 25); }
    }
    cloudX -= speed * 0.5;
    if (cloudX < -16) { cloudX = SCREEN_WIDTH; cloudY = random(4, 12); }

    int dinoW = isDucking ? 16 : 12;
    int dinoH = isDucking ? 8 : 12;
    int dinoCurY = isDucking ? 46 : (int)dinoY;

    int ax1 = 10, ay1 = dinoCurY, ax2 = 10 + dinoW, ay2 = dinoCurY + dinoH;
    int bx1 = (int)obsX, by1 = obsY, bx2 = (int)obsX + obsW, by2 = obsY + obsH;

    if (!(ax2 - 2 <= bx1 || ax1 + 2 >= bx2 || ay2 - 1 <= by1 || ay1 + 1 >= by2)) {
      running = false;
    }

    display.clearDisplay();

    for (int i = 0; i < 3; i++) display.drawPixel((int)starX[i], starY[i], SSD1306_WHITE);
    display.drawBitmap((int)cloudX, cloudY, cloud_16x8, 16, 8, SSD1306_WHITE);
    display.drawFastHLine(0, 54, SCREEN_WIDTH, SSD1306_WHITE);

    if (obsType == 0) display.drawBitmap((int)obsX, obsY, cactus_small, 6, 12, SSD1306_WHITE);
    else if (obsType == 1) display.drawBitmap((int)obsX, obsY, cactus_double, 12, 12, SSD1306_WHITE);
    else display.drawBitmap((int)obsX, obsY, animFrame ? bird_wingup : bird_wingdown, 8, 8, SSD1306_WHITE);

    const unsigned char* dinoBmp = isDucking ? (animFrame ? dino_duck1 : dino_duck2) : (animFrame ? dino_run1 : dino_run2);
    display.drawBitmap(10, dinoCurY, dinoBmp, dinoW, dinoH, SSD1306_WHITE);



    display.display();
    delay(15); 
  }

  gameOver(score);
  inGame = false;
}

// ===================== GAME 2: SNAKE =====================
void snakeGame() {
  const int cellSize = 4;
  const int gridWidth = 30;
  const int gridHeight = 13;
  const int offsetX = 4;
  const int offsetY = 10;

  struct Point { int x, y; };
  Point snake[100];
  int snakeLength = 3;
  snake[0] = {gridWidth / 2, gridHeight / 2};
  snake[1] = {gridWidth / 2 - 1, gridHeight / 2};
  snake[2] = {gridWidth / 2 - 2, gridHeight / 2};

  int dx = 1, dy = 0;
  bool running = true;
  int score = 0;

  Point food;
  auto respawnFood = [&]() {
    bool onBody = true;
    while (onBody) {
      food = { (int)random(0, gridWidth), (int)random(0, gridHeight) };
      onBody = false;
      for (int i = 0; i < snakeLength; i++) {
        if (snake[i].x == food.x && snake[i].y == food.y) { onBody = true; break; }
      }
    }
  };
  respawnFood();

  while (running) {
    if (digitalRead(UP_BUTTON) == LOW && dy != 1) { dx = 0; dy = -1; }
    else if (digitalRead(DOWN_BUTTON) == LOW && dy != -1) { dx = 0; dy = 1; }
    else if (digitalRead(LEFT_BUTTON) == LOW && dx != 1) { dx = -1; dy = 0; }
    else if (digitalRead(RIGHT_BUTTON) == LOW && dx != -1) { dx = 1; dy = 0; }

    Point newHead = { (snake[0].x + dx + gridWidth) % gridWidth, (snake[0].y + dy + gridHeight) % gridHeight };

    for (int i = 0; i < snakeLength; i++) {
      if (snake[i].x == newHead.x && snake[i].y == newHead.y) {
        running = false;
        break;
      }
    }

    for (int i = snakeLength; i > 0; i--) {
      snake[i] = snake[i - 1];
    }
    snake[0] = newHead;

    if (newHead.x == food.x && newHead.y == food.y) {
      snakeLength = min(snakeLength + 1, 99);
      score++;
      respawnFood();
    }

    display.clearDisplay();
    display.drawRect(offsetX - 2, offsetY - 2, gridWidth * cellSize + 4, gridHeight * cellSize + 4, SSD1306_WHITE);
    display.fillRect(food.x * cellSize + offsetX, food.y * cellSize + offsetY, cellSize, cellSize, SSD1306_WHITE);

    for (int i = 0; i < snakeLength; i++) {
      display.fillRect(snake[i].x * cellSize + offsetX, snake[i].y * cellSize + offsetY, cellSize, cellSize, SSD1306_WHITE);
    }


    display.display();

    delay(120 - min(score * 3, 80));
  }

  gameOver(score);
  inGame = false;
}

// ===================== GAME 3: FLAPPY STONE =====================
void flappystone() {
  const int birdX = 20;
  float birdY = 30;
  float birdVelocity = 0;
  float gravity = 0.2;
  float jumpStrength = -2.5;

  const int pipeWidth = 16;
  float pipeX = SCREEN_WIDTH;
  int pipeGapY = random(10, 32);
  const int gapHeight = 28; // Increased from 22 for easier gameplay

  int score = 0;
  bool playing = true;
  bool lastOK = false;

  while (playing) {
    bool currentOK = (digitalRead(OK_BUTTON) == LOW);
    if (currentOK && !lastOK) {
      birdVelocity = jumpStrength;
    }
    lastOK = currentOK;

    birdVelocity += gravity;
    birdY += birdVelocity;

    if (birdY < 0) { birdY = 0; birdVelocity = 0; }
    if (birdY > SCREEN_HEIGHT - 8) break;

    pipeX -= 1.5; // Smooth sub-pixel movement
    if (pipeX + pipeWidth < 0) {
      pipeX = SCREEN_WIDTH;
      pipeGapY = random(10, 32);
      score++;
    }

    if (pipeX < birdX + 8 && pipeX + pipeWidth > birdX) {
      if (birdY < pipeGapY || birdY + 8 > pipeGapY + gapHeight) {
        break;
      }
    }

    display.clearDisplay();
    display.drawFastHLine(0, SCREEN_HEIGHT - 1, SCREEN_WIDTH, SSD1306_WHITE);

    display.fillRect((int)pipeX + 2, 0, pipeWidth - 4, pipeGapY - 4, SSD1306_WHITE);
    display.fillRect((int)pipeX, pipeGapY - 4, pipeWidth, 4, SSD1306_WHITE);
    display.fillRect((int)pipeX, pipeGapY + gapHeight, pipeWidth, 4, SSD1306_WHITE);
    display.fillRect((int)pipeX + 2, pipeGapY + gapHeight + 4, pipeWidth - 4, SCREEN_HEIGHT - (pipeGapY + gapHeight + 4), SSD1306_WHITE);

    display.drawBitmap(birdX, (int)birdY, flappy_bird_sprite, 8, 8, SSD1306_WHITE);



    display.display();
    delay(15); // Faster loop = much smoother frame rate
  }

  gameOver(score);
  inGame = false;
}

void ticTacToe() {
  char board[3][3];
  memset(board, ' ', sizeof(board));
  int cursorX = 0, cursorY = 0;
  bool isXturn = true;
  bool playing = true;
  int playMode = 0; 
  
  display.clearDisplay();
  display.setCursor(15, 10);
  display.print("Select Mode:");
  display.setCursor(15, 30);
  display.print("> 1 Player (AI)");
  display.setCursor(15, 45);
  display.print("  2 Players");
  display.display();

  delay(200);
  while(true) {
    if (digitalRead(UP_BUTTON) == LOW || digitalRead(DOWN_BUTTON) == LOW) {
      playMode = 1 - playMode;
      display.clearDisplay();
      display.setCursor(15, 10);
      display.print("Select Mode:");
      display.setCursor(15, 30);
      display.print(playMode == 0 ? "> 1 Player (AI)" : "  1 Player (AI)");
      display.setCursor(15, 45);
      display.print(playMode == 1 ? "> 2 Players" : "  2 Players");
      display.display();
      delay(200);
    }
    if (digitalRead(OK_BUTTON) == LOW) {
      delay(200);
      break;
    }
  }

  auto getWinner = [&]() {
    for (int i = 0; i < 3; i++) {
      if (board[i][0] != ' ' && board[i][0] == board[i][1] && board[i][1] == board[i][2]) return board[i][0];
      if (board[0][i] != ' ' && board[0][i] == board[1][i] && board[1][i] == board[2][i]) return board[0][i];
    }
    if (board[0][0] != ' ' && board[0][0] == board[1][1] && board[1][1] == board[2][2]) return board[0][0];
    if (board[0][2] != ' ' && board[0][2] == board[1][1] && board[1][1] == board[2][0]) return board[0][2];
    return ' ';
  };

  auto isFull = [&]() {
    for (int r=0; r<3; r++)
      for (int c=0; c<3; c++)
        if (board[r][c] == ' ') return false;
    return true;
  };

  auto makeAIMove = [&]() {
    for (int r=0; r<3; r++) {
      for (int c=0; c<3; c++) {
        if (board[r][c] == ' ') {
          board[r][c] = 'O';
          if (getWinner() == 'O') return;
          board[r][c] = ' ';
        }
      }
    }
    for (int r=0; r<3; r++) {
      for (int c=0; c<3; c++) {
        if (board[r][c] == ' ') {
          board[r][c] = 'X';
          if (getWinner() == 'X') {
            board[r][c] = 'O';
            return;
          }
          board[r][c] = ' ';
        }
      }
    }
    if (board[1][1] == ' ') { board[1][1] = 'O'; return; }
    while (true) {
      int r = random(0, 3);
      int c = random(0, 3);
      if (board[r][c] == ' ') { board[r][c] = 'O'; return; }
    }
  };

  while (playing) {
    display.clearDisplay();

    display.drawLine(42, 0, 42, 64, SSD1306_WHITE);
    display.drawLine(85, 0, 85, 64, SSD1306_WHITE);
    display.drawLine(0, 21, 128, 21, SSD1306_WHITE);
    display.drawLine(0, 42, 128, 42, SSD1306_WHITE);

    for (int r = 0; r < 3; r++) {
      for (int c = 0; c < 3; c++) {
        int px = c * 42 + 21;
        int py = r * 21 + 10;
        if (board[r][c] == 'X') {
          display.drawLine(px-8, py-6, px+8, py+6, SSD1306_WHITE);
          display.drawLine(px-8, py+6, px+8, py-6, SSD1306_WHITE);
        } else if (board[r][c] == 'O') {
          display.drawCircle(px, py, 7, SSD1306_WHITE);
        }
      }
    }

    display.drawRect(cursorX * 42 + 2, cursorY * 21 + 2, 38, 17, SSD1306_WHITE);
    display.display();

    if (!isXturn && playMode == 0) {
      delay(400);
      makeAIMove();
      char winner = getWinner();
      if (winner != ' ') {
        display.clearDisplay();
        display.setTextSize(2);
        display.setCursor(20, 20);
        display.print("AI Wins!");
        display.display();
        delay(2000);
        playing = false;
      } else if (isFull()) {
        display.clearDisplay();
        display.setTextSize(2);
        display.setCursor(20, 20);
        display.print("Draw!");
        display.display();
        delay(2000);
        playing = false;
      }
      isXturn = true;
      continue;
    }

    if (digitalRead(LEFT_BUTTON) == LOW && cursorX > 0) { cursorX--; delay(150); }
    if (digitalRead(RIGHT_BUTTON) == LOW && cursorX < 2) { cursorX++; delay(150); }
    if (digitalRead(UP_BUTTON) == LOW && cursorY > 0) { cursorY--; delay(150); }
    if (digitalRead(DOWN_BUTTON) == LOW && cursorY < 2) { cursorY++; delay(150); }
    
    if (digitalRead(OK_BUTTON) == LOW && board[cursorY][cursorX] == ' ') {
      board[cursorY][cursorX] = isXturn ? 'X' : 'O';
      char winner = getWinner();
      if (winner != ' ') {
        display.clearDisplay();
        display.setTextSize(2);
        display.setCursor(20, 20);
        display.print(winner); display.print(" Wins!");
        display.display();
        delay(2000);
        playing = false;
      } else if (isFull()) {
        display.clearDisplay();
        display.setTextSize(2);
        display.setCursor(20, 20);
        display.print("Draw!");
        display.display();
        delay(2000);
        playing = false;
      }
      isXturn = !isXturn;
      delay(200);
    }
  }

  inGame = false;
}

// ===================== GAME 5: PONG =====================
void pongGame() {
  int mode = 0;
  
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(15, 10);
  display.print("Select Mode:");
  display.setCursor(15, 30);
  display.print("> Play with AI");
  display.setCursor(15, 45);
  display.print("  Play with Friend");
  display.display();

  delay(200);
  while(true) {
    if (digitalRead(UP_BUTTON) == LOW || digitalRead(DOWN_BUTTON) == LOW) {
      mode = 1 - mode;
      display.clearDisplay();
      display.setCursor(15, 10);
      display.print("Select Mode:");
      display.setCursor(15, 30);
      display.print(mode == 0 ? "> Play with AI" : "  Play with AI");
      display.setCursor(15, 45);
      display.print(mode == 1 ? "> Play with Friend" : "  Play with Friend");
      display.display();
      delay(200);
    }
    if (digitalRead(OK_BUTTON) == LOW) {
      delay(200);
      break;
    }
  }

  int paddleHeight = 16;
  int paddleWidth = 3;
  int ballSize = 3;
  
  float leftPaddleY = SCREEN_HEIGHT / 2 - paddleHeight / 2;
  float rightPaddleY = SCREEN_HEIGHT / 2 - paddleHeight / 2;
  
  float ballX = SCREEN_WIDTH / 2;
  float ballY = SCREEN_HEIGHT / 2;
  
  float ballSpeedX = (random(0, 2) == 0) ? 1.6 : -1.6;
  float ballSpeedY = random(-10, 11) / 10.0;
  
  int p1Score = 0;
  int p2Score = 0;
  bool playing = true;

  int starX[6];
  int starY[6];
  for (int i=0; i<6; i++) {
    starX[i] = random(0, SCREEN_WIDTH);
    starY[i] = random(0, SCREEN_HEIGHT);
  }

  auto resetBall = [&]() {
    ballX = SCREEN_WIDTH / 2;
    ballY = SCREEN_HEIGHT / 2;
    ballSpeedX = (random(0, 2) == 0) ? 1.6 : -1.6;
    ballSpeedY = random(-10, 11) / 10.0;
    delay(500);
  };

  while (playing) {
    if (digitalRead(UP_BUTTON) == LOW && leftPaddleY > 0) leftPaddleY -= 2.2;
    if (digitalRead(DOWN_BUTTON) == LOW && leftPaddleY + paddleHeight < SCREEN_HEIGHT) leftPaddleY += 2.2;

    if (mode == 1) {
      if (digitalRead(LEFT_BUTTON) == LOW && rightPaddleY > 0) rightPaddleY -= 2.2;
      if (digitalRead(RIGHT_BUTTON) == LOW && rightPaddleY + paddleHeight < SCREEN_HEIGHT) rightPaddleY += 2.2;
    } else {
      // Smart imperfect AI
      if (random(0, 100) < 85) { 
        float diff = ballY - (rightPaddleY + paddleHeight / 2.0);
        float speed = max(1.0f, abs(ballSpeedX) * 0.65f);
        if (diff > 2 && rightPaddleY + paddleHeight < SCREEN_HEIGHT) rightPaddleY += speed;
        else if (diff < -2 && rightPaddleY > 0) rightPaddleY -= speed;
      }
    }

    ballX += ballSpeedX;
    ballY += ballSpeedY;

    // Top/Bottom bounce
    if (ballY <= 0) {
      ballY = 0;
      ballSpeedY = -ballSpeedY + (random(-10, 11) / 100.0);
    } else if (ballY + ballSize >= SCREEN_HEIGHT) {
      ballY = SCREEN_HEIGHT - ballSize;
      ballSpeedY = -ballSpeedY + (random(-10, 11) / 100.0);
    }

    // Left paddle collision (with bound protection and direction check)
    if (ballSpeedX < 0 && ballX <= paddleWidth && ballX >= 0) {
      if (ballY + ballSize >= leftPaddleY && ballY <= leftPaddleY + paddleHeight) {
        ballX = paddleWidth;
        ballSpeedX = -ballSpeedX;
        if (ballSpeedX < 3.2) ballSpeedX *= 1.05;

        float hitPos = (ballY + ballSize / 2.0) - (leftPaddleY + paddleHeight / 2.0);
        ballSpeedY = (hitPos / (paddleHeight / 2.0)) * 1.8 + (random(-20, 21) / 100.0);
      }
    }

    // Right paddle collision (with bound protection and direction check)
    if (ballSpeedX > 0 && ballX + ballSize >= SCREEN_WIDTH - paddleWidth && ballX + ballSize <= SCREEN_WIDTH) {
      if (ballY + ballSize >= rightPaddleY && ballY <= rightPaddleY + paddleHeight) {
        ballX = SCREEN_WIDTH - paddleWidth - ballSize;
        ballSpeedX = -ballSpeedX;
        if (abs(ballSpeedX) < 3.2) ballSpeedX *= 1.05;

        float hitPos = (ballY + ballSize / 2.0) - (rightPaddleY + paddleHeight / 2.0);
        ballSpeedY = (hitPos / (paddleHeight / 2.0)) * 1.8 + (random(-20, 21) / 100.0);
      }
    }

    // Score checks
    if (ballX < 0) {
      p2Score++;
      if (p2Score >= 3) playing = false;
      else resetBall();
    } else if (ballX > SCREEN_WIDTH) {
      p1Score++;
      if (p1Score >= 3) playing = false;
      else resetBall();
    }

    // Star movement
    for (int i=0; i<6; i++) {
      starX[i] -= 1;
      if (starX[i] < 0) { starX[i] = SCREEN_WIDTH; starY[i] = random(0, SCREEN_HEIGHT); }
    }

    display.clearDisplay();

    for (int i=0; i<6; i++) display.drawPixel(starX[i], starY[i], SSD1306_WHITE);

    display.fillRect(0, (int)leftPaddleY, paddleWidth, paddleHeight, SSD1306_WHITE);
    display.fillRect(SCREEN_WIDTH - paddleWidth, (int)rightPaddleY, paddleWidth, paddleHeight, SSD1306_WHITE);
    display.fillRect((int)ballX, (int)ballY, ballSize, ballSize, SSD1306_WHITE);
    


    display.display();
    delay(15); 
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(2);
  display.setCursor(15, 10);
  if (p1Score >= 3) display.print("P1 Wins!");
  else display.print("P2 Wins!");
  display.setTextSize(1);
  display.setCursor(20, 42);
  display.print("Final Score: "); display.print(p1Score); display.print(" - "); display.print(p2Score);
  display.display();
  delay(3000);
  
  inGame = false;
}

void marioMiniGame() {
  const int GROUND_Y = 54;
  int camX = 0;
  int score = 0;

  float marioX = 30;
  float marioY = GROUND_Y - 14;
  float marioVY = 0;
  const float gravity = 0.45;
  const float jumpForce = -6.2;
  const float moveSpeed = 2.0;
  bool onGround = true;
  bool faceRight = true;

  struct Entity { float x, y; int w, h, type; bool active; }; 
  const int maxEntities = 6;
  Entity entities[maxEntities];

  auto spawnEntity = [&](int idx, int worldX) {
    int t = random(0, 3);
    entities[idx].type = t;
    entities[idx].active = true;
    entities[idx].x = worldX;
    if (t == 0) { entities[idx].w = 16; entities[idx].h = 16; entities[idx].y = GROUND_Y - 16; }
    else if (t == 1) { entities[idx].w = 12; entities[idx].h = 10; entities[idx].y = GROUND_Y - 10; }
    else { entities[idx].w = 8; entities[idx].h = 8; entities[idx].y = GROUND_Y - 24 - random(0, 8); }
  };

  for (int i = 0; i < maxEntities; i++) {
    spawnEntity(i, 140 + i * 70);
  }

  bool playing = true;
  uint8_t runFrame = 0;
  unsigned long animTimer = 0;

  auto overlap = [](float ax, float ay, int aw, int ah, float bx, float by, int bw, int bh) {
    return !(ax + aw <= bx || bx + bw <= ax || ay + ah <= by || by + bh <= ay);
  };

  while (playing) {
    bool left = (digitalRead(LEFT_BUTTON) == LOW);
    bool right = (digitalRead(RIGHT_BUTTON) == LOW);
    bool jump = (digitalRead(OK_BUTTON) == LOW);

    if (left) {
      marioX -= moveSpeed;
      if (marioX < 10) { marioX = 10; camX = max(0, camX - (int)moveSpeed); }
      faceRight = false;
    } else if (right) {
      if (marioX < 60) marioX += moveSpeed;
      else camX += moveSpeed;
      faceRight = true;
    }

    if (jump && onGround) {
      marioVY = jumpForce;
      onGround = false;
    }

    marioVY += gravity;
    marioY += marioVY;

    int firstBrickX = (camX / 80) * 80;
    onGround = false;
    for (int bx = firstBrickX - 80; bx < firstBrickX + 240; bx += 80) {
      int sx = bx - camX;
      if (marioVY > 0 && overlap(marioX, marioY, 12, 14, sx, GROUND_Y - 24, 8, 8)) {
        marioY = GROUND_Y - 24 - 14;
        marioVY = 0;
        onGround = true;
      }
      if (marioVY < 0 && overlap(marioX, marioY, 12, 14, sx, GROUND_Y - 24, 8, 8)) {
        marioVY = 0;
        score += 10;
      }
    }

    if (marioY + 14 >= GROUND_Y) {
      marioY = GROUND_Y - 14;
      marioVY = 0;
      onGround = true;
    }

    for (int i = 0; i < maxEntities; i++) {
      if (!entities[i].active) continue;
      if (entities[i].type == 1) entities[i].x -= 0.8;

      int sx = entities[i].x - camX;
      if (sx < -30) {
        spawnEntity(i, camX + SCREEN_WIDTH + random(20, 60));
        continue;
      }

      if (overlap(marioX, marioY, 12, 14, sx, entities[i].y, entities[i].w, entities[i].h)) {
        if (entities[i].type == 1) {
          if (marioVY > 0 && marioY + 14 - entities[i].y <= 6) {
            marioVY = jumpForce * 0.5;
            entities[i].active = false;
            score += 100;
          } else {
            playing = false;
          }
        } else if (entities[i].type == 2) {
          entities[i].active = false;
          score += 50;
        } else {
          playing = false;
        }
      }
    }

    if (millis() - animTimer > 100) {
      runFrame = (runFrame + 1) % 2;
      animTimer = millis();
    }

    display.clearDisplay();
    display.drawFastHLine(0, GROUND_Y, SCREEN_WIDTH, SSD1306_WHITE);

    for (int bx = firstBrickX - 80; bx < firstBrickX + 240; bx += 80) {
      int sx = bx - camX;
      if (sx > -8 && sx < SCREEN_WIDTH) {
        display.drawBitmap(sx, GROUND_Y - 24, brick_8x8, 8, 8, SSD1306_WHITE);
      }
    }

    for (int i = 0; i < maxEntities; i++) {
      if (!entities[i].active) continue;
      int sx = entities[i].x - camX;
      if (sx >= -16 && sx < SCREEN_WIDTH) {
        if (entities[i].type == 0) display.drawBitmap(sx, entities[i].y, pipe_16x18, 16, 18, SSD1306_WHITE);
        else if (entities[i].type == 1) display.drawBitmap(sx, entities[i].y, goomba_12x10, 12, 10, SSD1306_WHITE);
        else display.drawBitmap(sx, entities[i].y, coin_8x8, 8, 8, SSD1306_WHITE);
      }
    }

    const uint8_t* marioBmp = mario_stand_12x14;
    if (!onGround) marioBmp = mario_jump_12x14;
    else if (left || right) marioBmp = (runFrame == 0) ? mario_run1_12x14 : mario_run2_12x14;
    display.drawBitmap((int)marioX, (int)marioY, marioBmp, 12, 14, SSD1306_WHITE);


    display.display();
    delay(20);
  }

  gameOver(score);
  inGame = false;
}

// ===================== GAME 7: CAR DODGER =====================
void carDodgerGame() {
  const int ROAD_LEFT = 2;
  const int ROAD_RIGHT = 126;
  const int CAR_W = 12, CAR_H = 12;

  // Restored continuous smooth movement left-right!
  float carX = (SCREEN_WIDTH - CAR_W) / 2.0;
  const float carY = SCREEN_HEIGHT - CAR_H - 2;

  struct Enemy { float x, y, speed; int type; bool active; }; 
  const int maxEnemies = 2;
  Enemy enemies[maxEnemies];
  
  auto spawnEnemy = [&](int idx, float startY) {
    enemies[idx].active = true;
    enemies[idx].type = random(0, 3); // 0=car, 1=bike, 2=truck
    int w = (enemies[idx].type == 2) ? 14 : 12;
    enemies[idx].x = random(ROAD_LEFT + 2, ROAD_RIGHT - w - 2);
    enemies[idx].y = startY;
    enemies[idx].speed = 1.5 + (random(0, 10) / 10.0); // scaled down for 15ms frame rate
  };

  spawnEnemy(0, -30);
  spawnEnemy(1, -70);

  int score = 0;
  float roadOffset = 0;
  bool running = true;

  while(running) {
    // Increased reflex speed from 2.0 to 2.2 with a faster 15ms loop!
    if (digitalRead(LEFT_BUTTON) == LOW) carX -= 2.2;
    if (digitalRead(RIGHT_BUTTON) == LOW) carX += 2.2;

    carX = constrain(carX, ROAD_LEFT + 2, ROAD_RIGHT - CAR_W - 2);

    roadOffset = fmod(roadOffset + 1.8, 12.0); // scaled for 15ms

    for (int i=0; i<maxEnemies; i++) {
      enemies[i].y += enemies[i].speed;
      if (enemies[i].y > SCREEN_HEIGHT) {
        score++;
        spawnEnemy(i, -random(20, 60));
        enemies[i].speed = 1.5 + (score / 16.0) + (random(0, 10) / 10.0);
        if (enemies[i].speed > 4.5) enemies[i].speed = 4.5;
      }

      int ew = (enemies[i].type == 2) ? 14 : 12;
      int eh = (enemies[i].type == 2) ? 16 : 12;

      if (!(carX + CAR_W <= enemies[i].x || enemies[i].x + ew <= carX ||
            carY + CAR_H <= enemies[i].y || enemies[i].y + eh <= carY)) {
        running = false;
      }
    }

    display.clearDisplay();

    display.drawFastVLine(ROAD_LEFT, 0, SCREEN_HEIGHT, SSD1306_WHITE);
    display.drawFastVLine(ROAD_RIGHT, 0, SCREEN_HEIGHT, SSD1306_WHITE);
    
    for (int y = -roadOffset; y < SCREEN_HEIGHT; y += 12) {
      display.drawFastVLine(43, y, 6, SSD1306_WHITE);
      display.drawFastVLine(85, y, 6, SSD1306_WHITE);
    }

    for (int i=0; i<maxEnemies; i++) {
      if (enemies[i].y >= -16) {
        if (enemies[i].type == 2) {
          display.fillRect((int)enemies[i].x, (int)enemies[i].y, 14, 16, SSD1306_WHITE);
        } else {
          display.drawBitmap((int)enemies[i].x, (int)enemies[i].y, obstacleCarSprite, CAR_W, CAR_H, SSD1306_WHITE);
        }
      }
    }

    display.drawBitmap((int)carX, (int)carY, carSprite12x12, CAR_W, CAR_H, SSD1306_WHITE);


    display.display();
    delay(15); // Faster loop = smoother rendering
  }

  gameOver(score);
  inGame = false;
}

void tappyTapGame() {
  // Timing-based Block Stacker (Tappy Stack)
  // Single, precise clicks on OK button only. Hardware friendly!
  const int rowHeight = 6;
  const int maxRows = 10; // Fits within the OLED bounds
  
  int stackedX[maxRows];
  int stackedWidth[maxRows];
  for (int i = 0; i < maxRows; i++) {
    stackedX[i] = 0;
    stackedWidth[i] = 0;
  }

  int score = 0;
  int currentRow = 0;
  
  float blockX = 10;
  int blockWidth = 36; // wide initial block
  float blockSpeed = 1.8;
  int dir = 1;
  
  bool playing = true;
  bool released = false;

  while (digitalRead(OK_BUTTON) == LOW) delay(10);

  while (playing) {
    // Move active block
    blockX += dir * blockSpeed;
    if (blockX <= 4) {
      blockX = 4;
      dir = 1;
    } else if (blockX + blockWidth >= 124) {
      blockX = 124 - blockWidth;
      dir = -1;
    }

    bool okPressed = (digitalRead(OK_BUTTON) == LOW);
    if (okPressed && released) {
      released = false;
      
      int bx = (int)blockX;
      
      if (currentRow == 0) {
        // First block lands automatically
        stackedX[0] = bx;
        stackedWidth[0] = blockWidth;
        currentRow++;
        score += 10;
        blockX = 10;
        blockSpeed = 1.8 + (currentRow * 0.15);
      } else {
        // Crop block based on alignment with the block directly below
        int belowX = stackedX[currentRow - 1];
        int belowW = stackedWidth[currentRow - 1];
        
        int left = max(bx, belowX);
        int right = min(bx + blockWidth, belowX + belowW);
        int newW = right - left;
        
        if (newW <= 0) {
          // Missed completely!
          playing = false;
        } else {
          // Successful placement
          stackedX[currentRow] = left;
          stackedWidth[currentRow] = newW;
          blockWidth = newW; // block shrinks to alignment size
          score += 10;
          
          if (currentRow < maxRows - 2) {
            currentRow++;
          } else {
            // Scroll history down
            for (int i = 0; i < maxRows - 1; i++) {
              stackedX[i] = stackedX[i + 1];
              stackedWidth[i] = stackedWidth[i + 1];
            }
          }
          
          // Spawn new block with speed increment
          blockX = random(4, 120 - blockWidth);
          blockSpeed = 1.8 + (score / 40.0);
          if (blockSpeed > 4.5) blockSpeed = 4.5;
        }
      }
    }

    if (!okPressed) {
      released = true;
    }

    display.clearDisplay();

    // Border
    display.drawRect(2, 2, 124, 60, SSD1306_WHITE);

    // Draw stacked blocks
    for (int i = 0; i < currentRow; i++) {
      int ry = 54 - (i * rowHeight);
      display.fillRect(stackedX[i], ry, stackedWidth[i], rowHeight - 1, SSD1306_WHITE);
    }

    // Draw active moving block
    int activeY = 54 - (currentRow * rowHeight);
    display.fillRect((int)blockX, activeY, blockWidth, rowHeight - 1, SSD1306_WHITE);



    display.display();
    delay(15);
  }

  gameOver(score);
  inGame = false;
}

// ===================== GAME 9: SPACE INVADERS =====================
void spaceInvaderGame() {
  // Brand new Galaga / Retro Space Shooter style!
  float playerX = 60.0;
  const float playerY = 46.0; // Fits 8x16 ship nicely at the bottom
  int lives = 3;
  int score = 0;
  int wave = 1;
  int enemiesKilled = 0;
  
  // Powerup state
  bool doubleShot = false;
  unsigned long doubleShotTimer = 0;
  bool shield = false;
  unsigned long shieldTimer = 0;

  // Starfield background
  float starX[8];
  float starY[8];
  for (int i = 0; i < 8; i++) {
    starX[i] = random(0, SCREEN_WIDTH);
    starY[i] = random(0, SCREEN_HEIGHT);
  }

  // Player Bullets
  const int maxBullets = 6;
  float bulletX[maxBullets];
  float bulletY[maxBullets];
  bool bulletActive[maxBullets];
  for (int i = 0; i < maxBullets; i++) bulletActive[i] = false;
  unsigned long lastFireTime = 0;

  // Enemy Bullets
  const int maxEnemyBullets = 4;
  float eBulletX[maxEnemyBullets];
  float eBulletY[maxEnemyBullets];
  bool eBulletActive[maxEnemyBullets];
  for (int i = 0; i < maxEnemyBullets; i++) eBulletActive[i] = false;

  // Enemies
  struct Enemy {
    float x, y;
    float vx, vy;
    float centerX; // For Scout sine wave oscillation
    int type;      // 0 = Scout, 1 = Bomber, 2 = Kamikaze
    int hp;
    bool active;
    unsigned long lastShotTime;
  };
  const int maxEnemies = 3;
  Enemy enemies[maxEnemies];

  auto spawnEnemy = [&](int idx) {
    enemies[idx].active = true;
    enemies[idx].type = random(0, 3);
    enemies[idx].hp = (enemies[idx].type == 1) ? 2 : 1; // Bomber has 2 HP
    enemies[idx].x = random(10, SCREEN_WIDTH - 26);
    enemies[idx].y = -random(15, 60);
    enemies[idx].centerX = enemies[idx].x;
    enemies[idx].vx = (random(0, 2) == 0) ? 0.6 : -0.6;
    enemies[idx].vy = 0.5 + (wave * 0.1) + (random(0, 5) / 10.0);
    enemies[idx].lastShotTime = millis() + random(500, 2000);
  };

  for (int i = 0; i < maxEnemies; i++) {
    spawnEnemy(i);
  }

  // Boss State
  bool bossActive = false;
  float bossX = 48.0;
  float bossY = -20.0;
  float bossVx = 1.0;
  int bossHP = 0;
  unsigned long bossLastShot = 0;

  // Power-up drops
  float pUpX = 0, pUpY = 0;
  int pUpType = -1; // -1 = inactive, 0 = Double Shot, 1 = Shield
  bool pUpActive = false;

  // Particle System (Explosions)
  const int maxParticles = 10;
  float partX[maxParticles];
  float partY[maxParticles];
  float partVx[maxParticles];
  float partVy[maxParticles];
  int partLife[maxParticles];
  for (int i = 0; i < maxParticles; i++) partLife[i] = 0;

  auto spawnExplosion = [&](float x, float y) {
    for (int i = 0; i < maxParticles; i++) {
      partX[i] = x;
      partY[i] = y;
      partVx[i] = (random(-150, 151) / 100.0);
      partVy[i] = (random(-150, 151) / 100.0);
      partLife[i] = random(8, 16);
    }
  };

  while (digitalRead(OK_BUTTON) == LOW || digitalRead(UP_BUTTON) == LOW) delay(10);

  bool playing = true;

  while (playing && lives > 0) {
    // --- Inputs & Movement ---
    if (digitalRead(LEFT_BUTTON) == LOW) playerX -= 2.2;
    if (digitalRead(RIGHT_BUTTON) == LOW) playerX += 2.2;
    playerX = constrain(playerX, 0, SCREEN_WIDTH - 8);

    // Shooting
    if (digitalRead(OK_BUTTON) == LOW && (millis() - lastFireTime > 250)) {
      lastFireTime = millis();
      if (doubleShot) {
        int s1 = -1, s2 = -1;
        for (int i = 0; i < maxBullets; i++) {
          if (!bulletActive[i]) {
            if (s1 == -1) s1 = i;
            else if (s2 == -1) { s2 = i; break; }
          }
        }
        if (s1 != -1 && s2 != -1) {
          bulletActive[s1] = true; bulletX[s1] = playerX - 1; bulletY[s1] = playerY;
          bulletActive[s2] = true; bulletX[s2] = playerX + 7; bulletY[s2] = playerY;
        }
      } else {
        for (int i = 0; i < maxBullets; i++) {
          if (!bulletActive[i]) {
            bulletActive[i] = true;
            bulletX[i] = playerX + 3;
            bulletY[i] = playerY;
            break;
          }
        }
      }
    }

    // --- Starfield Background update ---
    for (int i = 0; i < 8; i++) {
      starY[i] += 1.2;
      if (starY[i] >= SCREEN_HEIGHT) {
        starY[i] = 0;
        starX[i] = random(0, SCREEN_WIDTH);
      }
    }

    // --- Particle System update ---
    for (int i = 0; i < maxParticles; i++) {
      if (partLife[i] > 0) {
        partX[i] += partVx[i];
        partY[i] += partVy[i];
        partLife[i]--;
      }
    }

    // --- Power-up Timers ---
    if (doubleShot && (millis() > doubleShotTimer)) doubleShot = false;
    if (shield && (millis() > shieldTimer)) shield = false;

    // --- Update Player Bullets ---
    for (int i = 0; i < maxBullets; i++) {
      if (bulletActive[i]) {
        bulletY[i] -= 3.5;
        if (bulletY[i] < 0) bulletActive[i] = false;
      }
    }

    // --- Update Enemy Bullets ---
    for (int i = 0; i < maxEnemyBullets; i++) {
      if (eBulletActive[i]) {
        eBulletY[i] += 2.0;
        if (eBulletY[i] > SCREEN_HEIGHT) eBulletActive[i] = false;

        // Collision with player
        if (eBulletX[i] >= playerX && eBulletX[i] <= playerX + 8 &&
            eBulletY[i] >= playerY && eBulletY[i] <= playerY + 16) {
          eBulletActive[i] = false;
          if (shield) {
            shield = false; // shield absorbs hit
          } else {
            lives--;
            spawnExplosion(playerX + 4, playerY + 8);
            delay(800);
          }
        }
      }
    }

    // --- Update Power-up Drop ---
    if (pUpActive) {
      pUpY += 1.0;
      if (pUpY > SCREEN_HEIGHT) pUpActive = false;

      // Overlap with player (Player size is 8x16)
      if (pUpX + 6 >= playerX && pUpX <= playerX + 8 &&
          pUpY + 6 >= playerY && pUpY <= playerY + 16) {
        pUpActive = false;
        if (pUpType == 0) {
          doubleShot = true;
          doubleShotTimer = millis() + 8000;
        } else {
          shield = true;
          shieldTimer = millis() + 10000;
        }
      }
    }

    // --- Update Enemies ---
    if (!bossActive) {
      for (int i = 0; i < maxEnemies; i++) {
        if (!enemies[i].active) continue;

        // Movement pattern based on type
        if (enemies[i].type == 0) {
          // Scout: Sine wave movement
          enemies[i].y += enemies[i].vy;
          enemies[i].centerX += enemies[i].vx;
          if (enemies[i].centerX < 10 || enemies[i].centerX > SCREEN_WIDTH - 26) {
            enemies[i].vx = -enemies[i].vx;
          }
          enemies[i].x = enemies[i].centerX + sin(enemies[i].y / 6.0) * 12.0;
        } else if (enemies[i].type == 1) {
          // Bomber: Slides down slowly, moves left/right
          enemies[i].y += enemies[i].vy * 0.7;
          enemies[i].x += enemies[i].vx;
          if (enemies[i].x < 10 || enemies[i].x > SCREEN_WIDTH - 26) {
            enemies[i].vx = -enemies[i].vx;
          }
        } else {
          // Kamikaze: Charges player horizontally!
          enemies[i].y += enemies[i].vy * 1.3;
          if (enemies[i].y > 10 && enemies[i].y < playerY - 10) {
            if (enemies[i].x < playerX) enemies[i].x += 0.8;
            else if (enemies[i].x > playerX) enemies[i].x -= 0.8;
          }
        }

        // Wrap around bottom
        if (enemies[i].y > SCREEN_HEIGHT) {
          spawnEnemy(i);
        }

        // Enemy shooting
        if (enemies[i].active && enemies[i].y > 0 && (millis() > enemies[i].lastShotTime)) {
          enemies[i].lastShotTime = millis() + random(1500, 3000);
          for (int b = 0; b < maxEnemyBullets; b++) {
            if (!eBulletActive[b]) {
              eBulletActive[b] = true;
              eBulletX[b] = enemies[i].x + 8;
              eBulletY[b] = enemies[i].y + 8;
              break;
            }
          }
        }

        // Collision with player ship
        if (enemies[i].x + 16 >= playerX && enemies[i].x <= playerX + 8 &&
            enemies[i].y + 8 >= playerY && enemies[i].y <= playerY + 16) {
          spawnExplosion(enemies[i].x + 8, enemies[i].y + 4);
          spawnEnemy(i);
          if (shield) {
            shield = false;
          } else {
            lives--;
            delay(800);
          }
        }

        // Collision with player bullets
        for (int b = 0; b < maxBullets; b++) {
          if (bulletActive[b]) {
            if (bulletX[b] >= enemies[i].x && bulletX[b] <= enemies[i].x + 16 &&
                bulletY[b] >= enemies[i].y && bulletY[b] <= enemies[i].y + 8) {
              bulletActive[b] = false;
              enemies[i].hp--;
              if (enemies[i].hp <= 0) {
                spawnExplosion(enemies[i].x + 8, enemies[i].y + 4);
                
                // Spawn Powerup drop (20% chance)
                if (random(0, 10) < 2 && !pUpActive) {
                  pUpActive = true;
                  pUpX = enemies[i].x + 4;
                  pUpY = enemies[i].y;
                  pUpType = random(0, 2);
                }

                spawnEnemy(i);
                score += 20;
                enemiesKilled++;

                // Trigger Boss fight every 15 kills
                if (enemiesKilled >= 15) {
                  bossActive = true;
                  bossX = 48.0;
                  bossY = -30.0;
                  bossHP = 15 + wave * 5;
                  bossLastShot = millis() + 1000;
                  for (int k = 0; k < maxEnemies; k++) enemies[k].active = false;
                }
              }
            }
          }
        }
      }
    } else {
      // --- BOSS UPDATE ---
      if (bossY < 8.0) {
        bossY += 0.5;
      } else {
        bossX += bossVx;
        if (bossX < 10 || bossX > SCREEN_WIDTH - 42) {
          bossVx = -bossVx;
        }
      }

      // Boss shooting
      if (millis() > bossLastShot) {
        bossLastShot = millis() + random(1000, 2000);
        int fired = 0;
        for (int b = 0; b < maxEnemyBullets; b++) {
          if (!eBulletActive[b]) {
            eBulletActive[b] = true;
            eBulletX[b] = bossX + 8 + (fired * 16);
            eBulletY[b] = bossY + 12;
            fired++;
            if (fired >= 2) break;
          }
        }
      }

      // Collision with player bullets
      for (int b = 0; b < maxBullets; b++) {
        if (bulletActive[b]) {
          if (bulletX[b] >= bossX && bulletX[b] <= bossX + 32 &&
              bulletY[b] >= bossY && bulletY[b] <= bossY + 12) {
            bulletActive[b] = false;
            bossHP--;
            if (bossHP <= 0) {
              spawnExplosion(bossX + 16, bossY + 6);
              spawnExplosion(bossX + 8, bossY + 6);
              spawnExplosion(bossX + 24, bossY + 6);
              score += 200;
              wave++;
              enemiesKilled = 0;
              bossActive = false;

              // Respawn normal enemies
              for (int k = 0; k < maxEnemies; k++) spawnEnemy(k);
            }
          }
        }
      }
    }

    // --- Draw ---
    display.clearDisplay();

    // 1. Draw starfield background
    for (int i = 0; i < 8; i++) {
      display.drawPixel((int)starX[i], (int)starY[i], SSD1306_WHITE);
    }

    // 2. Draw explosion particles
    for (int i = 0; i < maxParticles; i++) {
      if (partLife[i] > 0) {
        display.drawPixel((int)partX[i], (int)partY[i], SSD1306_WHITE);
      }
    }

    // 3. Draw player ship (8x16)
    display.drawBitmap((int)playerX, (int)playerY, playerShipVertical, 8, 16, SSD1306_WHITE);

    // Draw active shield ring
    if (shield) {
      display.drawCircle((int)playerX + 4, (int)playerY + 8, 10, SSD1306_WHITE);
    }

    // 4. Draw player bullets
    for (int i = 0; i < maxBullets; i++) {
      if (bulletActive[i]) {
        display.drawFastVLine((int)bulletX[i], (int)bulletY[i], 3, SSD1306_WHITE);
      }
    }

    // 5. Draw enemy bullets
    for (int i = 0; i < maxEnemyBullets; i++) {
      if (eBulletActive[i]) {
        display.fillRect((int)eBulletX[i], (int)eBulletY[i], 2, 2, SSD1306_WHITE);
      }
    }

    // 6. Draw powerup drop
    if (pUpActive) {
      if ((millis() / 150) % 2 == 0) {
        display.drawRect((int)pUpX, (int)pUpY, 6, 6, SSD1306_WHITE);
        display.setCursor((int)pUpX + 1, (int)pUpY - 1);
        display.print(pUpType == 0 ? "D" : "S");
      }
    }

    // 7. Draw enemies
    if (!bossActive) {
      for (int i = 0; i < maxEnemies; i++) {
        if (enemies[i].active && enemies[i].y >= 0) {
          display.drawBitmap((int)enemies[i].x, (int)enemies[i].y, invader, 16, 8, SSD1306_WHITE);
        }
      }
    } else {
      int bx = (int)bossX;
      int by = (int)bossY;
      display.fillRect(bx, by + 4, 32, 8, SSD1306_WHITE);
      display.fillRect(bx + 8, by, 16, 4, SSD1306_WHITE);
      display.fillRect(bx + 14, by + 12, 4, 2, SSD1306_WHITE); // cannon

      // Draw Boss Health Bar
      display.drawRect(34, 2, 60, 4, SSD1306_WHITE);
      int maxHP = 15 + wave * 5;
      int barW = (bossHP * 58) / maxHP;
      display.fillRect(35, 3, barW, 2, SSD1306_WHITE);
    }

    // 8. Draw UI HUD overlay (Score hidden during play)
    display.setTextSize(1);
    display.setCursor(95, 2);
    display.print("L:"); display.print(lives);
    
    display.display();
    delay(15);
  }

  gameOver(score);
  inGame = false;
}

// ===================== GAME 10: TETRIS LITE =====================
void tetrislite() {
  const int ORG_X = 10; 
  const int ORG_Y = 2;
  
  const int CELL_W = 5;
  const int CELL_H = 3;
  const int COLS = 10;
  const int ROWS = 20;
  const int W_PX = COLS * CELL_W; 
  const int H_PX = ROWS * CELL_H; 
  
  const int RightUI_X = 68; 

  uint8_t board[ROWS][COLS];
  memset(board, 0, sizeof(board));

  const uint16_t SHAPES[7][4] = {
    { 0x0f00, 0x2222, 0x00f0, 0x4444 }, 
    { 0x8e00, 0x6440, 0x0e20, 0x44c0 }, 
    { 0x2e00, 0x4460, 0x0e80, 0xc440 }, 
    { 0x6600, 0x6600, 0x6600, 0x6600 }, 
    { 0x6c00, 0x4620, 0x06c0, 0x8c40 }, 
    { 0x4e00, 0x4640, 0x0e40, 0x4c40 }, 
    { 0xc600, 0x2640, 0x0c60, 0x4c80 }  
  };

  auto cellAtMask = [&](uint16_t mask, int x, int y) {
    return (mask >> (15 - (y * 4 + x))) & 1;
  };

  struct Piece { int type, rot, r, c; } cur, nxt;

  auto getPiece = [&]() {
    Piece p;
    p.type = random(0, 7); p.rot = 0; p.r = 0; p.c = 3;
    return p;
  };

  cur = getPiece();
  nxt = getPiece();

  auto collides = [&](Piece p) {
    uint16_t mask = SHAPES[p.type][p.rot];
    for (int y = 0; y < 4; y++) {
      for (int x = 0; x < 4; x++) {
        if (cellAtMask(mask, x, y)) {
          int rr = p.r + y;
          int cc = p.c + x;
          if (cc < 0 || cc >= COLS || rr >= ROWS) return true;
          if (rr >= 0 && board[rr][cc]) return true;
        }
      }
    }
    return false;
  };

  auto lockPiece = [&](Piece p) {
    uint16_t mask = SHAPES[p.type][p.rot];
    for (int y = 0; y < 4; y++) {
      for (int x = 0; x < 4; x++) {
        if (cellAtMask(mask, x, y)) {
          int rr = p.r + y;
          int cc = p.c + x;
          if (rr >= 0 && rr < ROWS && cc >= 0 && cc < COLS) board[rr][cc] = 1;
        }
      }
    }
  };

  auto clearLines = [&]() {
    int cleared = 0;
    for (int r = ROWS - 1; r >= 0; ) {
      bool full = true;
      for (int c = 0; c < COLS; c++) {
        if (!board[r][c]) { full = false; break; }
      }
      if (full) {
        cleared++;
        for (int rr = r; rr > 0; rr--) {
          for (int cc = 0; cc < COLS; cc++) board[rr][cc] = board[rr - 1][cc];
        }
        for (int cc = 0; cc < COLS; cc++) board[0][cc] = 0;
      } else {
        r--;
      }
    }
    return cleared;
  };

  auto ghostRow = [&](Piece p) {
    while (!collides(p)) p.r++;
    return p.r - 1;
  };

  int score = 0;
  int lines = 0;
  unsigned long lastFall = millis();
  unsigned long gravity = 600;

  bool lastL = false, lastR = false, lastU = false, lastOK = false;

  while (true) {
    bool L = (digitalRead(LEFT_BUTTON) == LOW);
    bool R = (digitalRead(RIGHT_BUTTON) == LOW);
    bool U = (digitalRead(UP_BUTTON) == LOW);
    bool D = (digitalRead(DOWN_BUTTON) == LOW);
    bool OK = (digitalRead(OK_BUTTON) == LOW);

    if (U && !lastU) {
      Piece test = cur;
      test.rot = (test.rot + 1) % 4;
      if (!collides(test)) cur = test;
      else {
        test.c -= 1;
        if (!collides(test)) cur = test;
        else {
          test.c += 2;
          if (!collides(test)) cur = test;
        }
      }
    }
    lastU = U;

    if (L && !lastL) { Piece test = cur; test.c--; if (!collides(test)) cur = test; }
    lastL = L;
    if (R && !lastR) { Piece test = cur; test.c++; if (!collides(test)) cur = test; }
    lastR = R;

    if (OK && !lastOK) {
      while (!collides(cur)) cur.r++;
      cur.r--;
      lockPiece(cur);
      int cl = clearLines();
      score += cl * 100;
      lines += cl;
      cur = nxt;
      nxt = getPiece();
      if (collides(cur)) break;
    }
    lastOK = OK;

    if (D) { Piece test = cur; test.r++; if (!collides(test)) cur = test; }

    if (millis() - lastFall > gravity) {
      lastFall = millis();
      Piece test = cur;
      test.r++;
      if (!collides(test)) cur = test;
      else {
        lockPiece(cur);
        int cl = clearLines();
        score += cl * 100;
        lines += cl;
        cur = nxt;
        nxt = getPiece();
        if (collides(cur)) break;
      }
    }

    display.clearDisplay();
    display.drawRect(ORG_X - 1, ORG_Y - 1, W_PX + 2, H_PX + 2, SSD1306_WHITE);

    for (int r = 0; r < ROWS; r++) {
      for (int c = 0; c < COLS; c++) {
        if (board[r][c]) {
          display.fillRect(ORG_X + c * CELL_W, ORG_Y + r * CELL_H, CELL_W, CELL_H, SSD1306_WHITE);
        }
      }
    }

    int gRow = ghostRow(cur);
    uint16_t mask = SHAPES[cur.type][cur.rot];
    for (int y = 0; y < 4; y++) {
      for (int x = 0; x < 4; x++) {
        if (cellAtMask(mask, x, y)) {
          int rr = gRow + y;
          int cc = cur.c + x;
          if (rr >= 0) {
            int tx = ORG_X + cc * CELL_W;
            int ty = ORG_Y + rr * CELL_H;
            display.drawRect(tx, ty, CELL_W, CELL_H, SSD1306_WHITE);
          }
        }
      }
    }

    for (int y = 0; y < 4; y++) {
      for (int x = 0; x < 4; x++) {
        if (cellAtMask(mask, x, y)) {
          int rr = cur.r + y;
          int cc = cur.c + x;
          if (rr >= 0) {
            display.fillRect(ORG_X + cc * CELL_W, ORG_Y + rr * CELL_H, CELL_W, CELL_H, SSD1306_WHITE);
          }
        }
      }
    }

    display.drawRect(RightUI_X, 2, 58, 60, SSD1306_WHITE);
    display.setCursor(RightUI_X+4, 6);
    display.print("TETRIS");

    display.setCursor(RightUI_X+4, 34);
    display.print("L:"); display.print(lines);

    display.setCursor(RightUI_X+4, 46);
    display.print("NEXT");
    uint16_t nextMask = SHAPES[nxt.type][0];
    for (int y = 0; y < 4; y++) {
      for (int x = 0; x < 4; x++) {
        if (cellAtMask(nextMask, x, y)) {
          display.fillRect(RightUI_X + 34 + x * 4, 44 + y * 4, 3, 3, SSD1306_WHITE);
        }
      }
    }

    display.display();
    delay(10);
  }

  gameOver(score);
  inGame = false;
}

// ===================== GAME 11: BRICK KILLER =====================
void brickkillerGame() {
  int level = 0;
  
  display.clearDisplay();
  display.setCursor(15, 10);
  display.print("Select Level:");
  display.setCursor(15, 30);
  display.print("> Easy (L1)");
  display.setCursor(15, 45);
  display.print("  Medium (L2)");
  display.display();

  delay(200);
  while(true) {
    if (digitalRead(UP_BUTTON) == LOW || digitalRead(DOWN_BUTTON) == LOW) {
      level = 1 - level;
      display.clearDisplay();
      display.setCursor(15, 10);
      display.print("Select Level:");
      display.setCursor(15, 30);
      display.print(level == 0 ? "> Easy (L1)" : "  Easy (L1)");
      display.setCursor(15, 45);
      display.print(level == 1 ? "> Medium (L2)" : "  Medium (L2)");
      display.display();
      delay(200);
    }
    if (digitalRead(OK_BUTTON) == LOW) {
      delay(200);
      break;
    }
  }

  int paddleWidth = (level == 0) ? 24 : 16;
  const int paddleHeight = 3;
  float paddleX = (SCREEN_WIDTH - paddleWidth) / 2;
  const int paddleY = SCREEN_HEIGHT - 6;

  float ballX = SCREEN_WIDTH / 2;
  float ballY = SCREEN_HEIGHT / 2;
  float ballVX = 1.6;
  float ballVY = -1.6;

  const int brickRows = 3;
  const int brickCols = 8;
  const int brickWidth = 14;
  const int brickHeight = 5;
  bool bricks[brickRows][brickCols];
  memset(bricks, 1, sizeof(bricks));

  int score = 0;
  bool playing = true;

  while (playing) {
    if (digitalRead(LEFT_BUTTON) == LOW && paddleX > 0) paddleX -= 4.5;
    if (digitalRead(RIGHT_BUTTON) == LOW && paddleX + paddleWidth < SCREEN_WIDTH) paddleX += 4.5;

    ballX += ballVX;
    ballY += ballVY;

    if (ballX <= 0 || ballX + 3 >= SCREEN_WIDTH) ballVX *= -1;
    if (ballY <= 0) ballVY *= -1;
    if (ballY + 3 >= SCREEN_HEIGHT) break; 

    if (ballY + 3 >= paddleY && ballY + 3 <= paddleY + paddleHeight &&
        ballX + 3 >= paddleX && ballX <= paddleX + paddleWidth) {
      ballVY *= -1;
      float hit = (ballX + 1.5) - (paddleX + paddleWidth/2);
      ballVX = (hit / (paddleWidth/2)) * 2.2 + (random(-15, 16)/100.0);
    }

    for (int r = 0; r < brickRows; r++) {
      for (int c = 0; c < brickCols; c++) {
        if (bricks[r][c]) {
          int bx = c * (brickWidth + 2) + 2;
          int by = r * (brickHeight + 2) + 2;
          if (ballX + 3 > bx && ballX < bx + brickWidth &&
              ballY + 3 > by && ballY < by + brickHeight) {
            bricks[r][c] = false;
            ballVY *= -1;
            score += 10;
          }
        }
      }
    }

    bool win = true;
    for (int r=0; r<brickRows; r++)
      for(int c=0; c<brickCols; c++)
        if (bricks[r][c]) win = false;

    if (win) {
      display.clearDisplay();
      display.setCursor(20, 20);
      display.print("Level Clear!");
      display.display();
      delay(2000);
      break;
    }

    display.clearDisplay();
    for (int r = 0; r < brickRows; r++) {
      for (int c = 0; c < brickCols; c++) {
        if (bricks[r][c]) {
          display.fillRect(c * (brickWidth + 2) + 2, r * (brickHeight + 2) + 2, brickWidth, brickHeight, SSD1306_WHITE);
        }
      }
    }
    display.fillRect((int)paddleX, paddleY, paddleWidth, paddleHeight, SSD1306_WHITE);
    display.fillRect((int)ballX, (int)ballY, 3, 3, SSD1306_WHITE);


    display.display();
    delay(15); 
  }

  gameOver(score);
  inGame = false;
}

// ===================== GAME 12: PLAY 2048 =====================
void play2048() {
  int grid[4][4];
  memset(grid, 0, sizeof(grid));
  int score = 0;

  auto addTile = [&]() {
    int empty[16];
    int count = 0;
    for (int i=0; i<16; i++) {
      if (grid[i/4][i%4] == 0) empty[count++] = i;
    }
    if (count > 0) {
      int idx = empty[random(0, count)];
      grid[idx/4][idx%4] = (random(0, 2) == 0) ? 2 : 4;
    }
  };

  auto drawTinyDigit = [&](int x, int y, int val) {
    char buf[8];
    if (val >= 1000) { sprintf(buf, "%dK", val/1000); }
    else { sprintf(buf, "%d", val); }
    int len = strlen(buf);
    int startX = x + (12 - (len * 4 - 1)) / 2;
    int startY = y + 4;
    display.setTextColor(SSD1306_BLACK);
    display.setCursor(startX, startY);
    display.print(buf);
  };

  addTile();
  addTile();

  auto slideLeft = [&]() {
    bool moved = false;
    for (int r=0; r<4; r++) {
      int lastMerge = -1;
      for (int c=1; c<4; c++) {
        if (grid[r][c] == 0) continue;
        int k = c;
        while (k > 0 && grid[r][k-1] == 0) {
          grid[r][k-1] = grid[r][k];
          grid[r][k] = 0;
          k--;
          moved = true;
        }
        if (k > 0 && grid[r][k-1] == grid[r][k] && lastMerge != k-1) {
          grid[r][k-1] *= 2;
          score += grid[r][k-1];
          grid[r][k] = 0;
          lastMerge = k-1;
          moved = true;
        }
      }
    }
    return moved;
  };

  auto rotate = [&]() {
    int tmp[4][4];
    for (int r=0; r<4; r++)
      for (int c=0; c<4; c++)
        tmp[r][c] = grid[3-c][r];
    memcpy(grid, tmp, sizeof(grid));
  };

  while (true) {
    bool moved = false;
    if (digitalRead(LEFT_BUTTON) == LOW) { moved = slideLeft(); delay(200); }
    else if (digitalRead(RIGHT_BUTTON) == LOW) { rotate(); rotate(); moved = slideLeft(); rotate(); rotate(); delay(200); }
    else if (digitalRead(UP_BUTTON) == LOW) { rotate(); rotate(); rotate(); moved = slideLeft(); rotate(); delay(200); }
    else if (digitalRead(DOWN_BUTTON) == LOW) { rotate(); moved = slideLeft(); rotate(); rotate(); rotate(); delay(200); }

    if (moved) addTile();

    display.clearDisplay();

    for (int r=0; r<4; r++) {
      for (int c=0; c<4; c++) {
        int tx = c * 14 + 4;
        int ty = r * 14 + 6;
        if (grid[r][c] > 0) {
          display.fillRect(tx, ty, 12, 12, SSD1306_WHITE);
          drawTinyDigit(tx, ty, grid[r][c]);
        } else {
          display.drawRect(tx, ty, 12, 12, SSD1306_WHITE);
        }
      }
    }

    display.setTextColor(SSD1306_WHITE);
    display.drawRect(64, 4, 60, 56, SSD1306_WHITE);
    display.setCursor(72, 8);
    display.print("2048");


    display.display();

    bool gameOverState = true;
    for (int r=0; r<4; r++) {
      for (int c=0; c<4; c++) {
        if (grid[r][c] == 0) gameOverState = false;
        if (r < 3 && grid[r][c] == grid[r+1][c]) gameOverState = false;
        if (c < 3 && grid[r][c] == grid[r][c+1]) gameOverState = false;
      }
    }
    if (gameOverState) break;
  }

  gameOver(score);
  inGame = false;
}

// ===================== GAME 13: DOODLE JUMP =====================
void playDoodleJump() {
  float doodlerX = SCREEN_WIDTH/2;
  float doodlerY = SCREEN_HEIGHT - 10;
  float velocityY = 0;
  
  const float gravity = 0.38;
  const float jumpPower = -6.8;

  static int sessionHighScore = 0;

  struct Platform { float x, y; int type; float speed; bool active; }; 
  const int maxPlats = 5;
  Platform platforms[maxPlats];

  for (int i=0; i<maxPlats; i++) {
    platforms[i].x = random(5, SCREEN_WIDTH - 25);
    platforms[i].y = i * 12 + 10;
    platforms[i].type = random(0, 8); 
    if (platforms[i].type > 3) platforms[i].type = 0; 
    platforms[i].speed = 1.0;
    platforms[i].active = true;
  }

  int score = 0;
  bool running = true;
  float rocketBoostTime = 0; 

  while(running) {
    if (digitalRead(LEFT_BUTTON) == LOW) doodlerX -= 2.2;
    if (digitalRead(RIGHT_BUTTON) == LOW) doodlerX += 2.2;

    if (doodlerX < -4) doodlerX = SCREEN_WIDTH - 4;
    if (doodlerX > SCREEN_WIDTH) doodlerX = 0;

    if (rocketBoostTime > 0) {
      rocketBoostTime -= 20;
      velocityY = -9.0; 
    } else {
      velocityY += gravity;
    }
    
    doodlerY += velocityY;

    for (int i=0; i<maxPlats; i++) {
      if (platforms[i].type == 3) {
        platforms[i].x += platforms[i].speed;
        if (platforms[i].x <= 2 || platforms[i].x >= SCREEN_WIDTH - 22) {
          platforms[i].speed *= -1;
        }
      }
    }

    for (int i=0; i<maxPlats; i++) {
      if (platforms[i].active && velocityY > 0) {
        if (doodlerX + 8 >= platforms[i].x && doodlerX <= platforms[i].x + 20 &&
            doodlerY + 8 >= platforms[i].y && doodlerY + 5 <= platforms[i].y) {
          
          if (platforms[i].type == 2) { 
            rocketBoostTime = 1500;
            platforms[i].type = 0;
          } else if (platforms[i].type == 1) { 
            velocityY = jumpPower * 1.5;
            platforms[i].type = 0; 
          } else { 
            velocityY = jumpPower;
          }
        }
      }
    }

    if (doodlerY < SCREEN_HEIGHT / 2) {
      float diff = SCREEN_HEIGHT / 2 - doodlerY;
      doodlerY = SCREEN_HEIGHT / 2;
      score += diff;
      for (int i=0; i<maxPlats; i++) {
        platforms[i].y += diff;
        if (platforms[i].y > SCREEN_HEIGHT) {
          platforms[i].y = 0;
          platforms[i].x = random(5, SCREEN_WIDTH - 25);
          platforms[i].type = random(0, 8);
          if (platforms[i].type > 3) platforms[i].type = 0;
          platforms[i].speed = (random(0, 2) == 0) ? 1.0 : -1.0;
        }
      }
    }

    if (doodlerY > SCREEN_HEIGHT) break;

    display.clearDisplay();

    for (int i=0; i<maxPlats; i++) {
      display.fillRect((int)platforms[i].x, (int)platforms[i].y, 20, 3, SSD1306_WHITE);
      if (platforms[i].type == 2) { 
        display.drawBitmap((int)platforms[i].x + 6, (int)platforms[i].y - 8, rocketSprite, 8, 8, SSD1306_WHITE);
      } else if (platforms[i].type == 1) { 
        display.fillRect((int)platforms[i].x + 8, (int)platforms[i].y - 3, 4, 3, SSD1306_WHITE);
      }
    }

    display.drawBitmap((int)doodlerX, (int)doodlerY, doodlerSprite, 8, 8, SSD1306_WHITE);
    
    if (rocketBoostTime > 0) {
      display.drawLine((int)doodlerX + 4, (int)doodlerY + 8, (int)doodlerX + 4, (int)doodlerY + 14, SSD1306_WHITE);
    }


    display.setCursor(80, 0);
    display.print("HI:"); display.print(sessionHighScore);
    display.display();
    delay(20);
  }

  if (score > sessionHighScore) {
    sessionHighScore = score;
  }

  gameOver(score);
  inGame = false;
}

// ===================== GAME 13: MAZE SOLVER =====================
void mazeSolverGame() {
  const int COLS = 31;
  const int ROWS = 15;
  uint8_t maze[ROWS][COLS];
  memset(maze, 1, sizeof(maze));

  struct Point { int r, c; };
  Point stack[250];
  int top = -1;

  auto getNeighbors = [&](Point p, Point out[4]) {
    int cnt = 0;
    int dr[] = {-2, 2, 0, 0};
    int dc[] = {0, 0, -2, 2};
    for (int i=0; i<4; i++) {
      int nr = p.r + dr[i];
      int nc = p.c + dc[i];
      if (nr > 0 && nr < ROWS-1 && nc > 0 && nc < COLS-1 && maze[nr][nc] == 1) {
        out[cnt++] = {nr, nc};
      }
    }
    return cnt;
  };

  int level = 1;
  int baseTimer = 65; 
  bool inLevel = true;

  while(inLevel) {
    memset(maze, 1, sizeof(maze));
    top = -1;
    
    maze[1][1] = 0;
    stack[++top] = {1, 1};

    while (top >= 0) {
      Point curr = stack[top];
      Point neighbors[4];
      int count = getNeighbors(curr, neighbors);
      if (count > 0) {
        Point next = neighbors[random(0, count)];
        maze[next.r][next.c] = 0;
        maze[(curr.r + next.r)/2][(curr.c + next.c)/2] = 0;
        stack[++top] = next;
      } else {
        top--;
      }
    }

    maze[ROWS-2][COLS-2] = 0; 

    int playerR = 1, playerC = 1;
    int targetR = ROWS-2, targetC = COLS-2;

    int secondsLeft = baseTimer - (level * 5);
    if (secondsLeft < 15) secondsLeft = 15; 
    unsigned long timerStart = millis();

    bool levelWon = false;

    while (true) {
      if (digitalRead(LEFT_BUTTON) == LOW && maze[playerR][playerC-1] == 0) { playerC--; delay(130); }
      else if (digitalRead(RIGHT_BUTTON) == LOW && maze[playerR][playerC+1] == 0) { playerC++; delay(130); }
      else if (digitalRead(UP_BUTTON) == LOW && maze[playerR-1][playerC] == 0) { playerR--; delay(130); }
      else if (digitalRead(DOWN_BUTTON) == LOW && maze[playerR+1][playerC] == 0) { playerR++; delay(130); }

      int elapsed = (millis() - timerStart) / 1000;
      int tLeft = secondsLeft - elapsed;

      if (tLeft <= 0) {
        inLevel = false;
        break;
      }

      if (playerR == targetR && playerC == targetC) {
        levelWon = true;
        level++;
        display.clearDisplay();
        display.setTextSize(1.5);
        display.setCursor(20, 25);
        display.print("Level Complete!");
        display.display();
        delay(1500);
        break;
      }

      display.clearDisplay();

      for (int r=0; r<ROWS; r++) {
        for (int c=0; c<COLS; c++) {
          if (maze[r][c] == 1) {
            display.fillRect(c * 4 + 2, r * 4 + 2, 4, 4, SSD1306_WHITE);
          }
        }
      }

      display.fillRect(targetC * 4 + 3, targetR * 4 + 3, 2, 2, SSD1306_WHITE);

      bool blink = (millis() / 150) % 2;
      if (blink) {
        display.fillRect(playerC * 4 + 3, playerR * 4 + 3, 2, 2, SSD1306_WHITE);
      }

      display.setCursor(105, 52);
      display.setTextColor(SSD1306_WHITE, SSD1306_BLACK); 
      display.print(tLeft);

      display.display();
      delay(15);
    }

    if (!levelWon) {
      break; 
    }
  }

  gameOver(level * 100);
  inGame = false;
}

// ===================== GAME 14: PAC-MAN =====================
void generatePacmanMaze(uint8_t grid[8][12], int level) {
  // Fill with walls
  for (int r = 0; r < 8; r++) {
    for (int c = 0; c < 12; c++) {
      grid[r][c] = 1;
    }
  }

  // Maze generation variables (DFS)
  int stackX[48];
  int stackY[48];
  int stackSize = 0;

  bool visited[8][12];
  memset(visited, 0, sizeof(visited));

  // Intersections are at odd coordinates: c in {1,3,5,7,9}, r in {1,3,5}
  int startX = 1;
  int startY = 1;
  visited[startY][startX] = true;
  grid[startY][startX] = 0;

  stackX[stackSize] = startX;
  stackY[stackSize] = startY;
  stackSize++;

  while (stackSize > 0) {
    int cx = stackX[stackSize - 1];
    int cy = stackY[stackSize - 1];

    int neighborsX[4];
    int neighborsY[4];
    int count = 0;

    int dx[] = {2, -2, 0, 0};
    int dy[] = {0, 0, 2, -2};

    for (int i = 0; i < 4; i++) {
      int nx = cx + dx[i];
      int ny = cy + dy[i];
      if (nx > 0 && nx < 11 && ny > 0 && ny < 7) {
        if (!visited[ny][nx]) {
          neighborsX[count] = nx;
          neighborsY[count] = ny;
          count++;
        }
      }
    }

    if (count > 0) {
      int rIdx = random(0, count);
      int nx = neighborsX[rIdx];
      int ny = neighborsY[rIdx];

      grid[ny][nx] = 0;
      grid[cy + (ny - cy) / 2][cx + (nx - cx) / 2] = 0;

      visited[ny][nx] = true;

      stackX[stackSize] = nx;
      stackY[stackSize] = ny;
      stackSize++;
    } else {
      stackSize--;
    }
  }

  // Center ghost house setup
  grid[3][5] = 3;
  grid[3][6] = 3;
  grid[4][5] = 3;
  grid[4][6] = 3;
  
  // Ghost house exit path
  grid[2][5] = 0;
  grid[2][6] = 0;

  // Carve random loops to make the map less blocky and allow evasion
  int loopsCarved = 0;
  int targetLoops = 3 + (level > 4 ? 4 : level); // more paths at higher level
  int attempts = 0;
  while (loopsCarved < targetLoops && attempts < 50) {
    attempts++;
    int rx = random(1, 11);
    int ry = random(1, 7);
    if (grid[ry][rx] == 1) {
      bool leftRight = (grid[ry][rx-1] != 1 && grid[ry][rx+1] != 1);
      bool upDown = (grid[ry-1][rx] != 1 && grid[ry+1][rx] != 1);
      if (leftRight || upDown) {
        grid[ry][rx] = 0;
        loopsCarved++;
      }
    }
  }

  // Power pellets in corners
  grid[1][1] = 2;
  grid[1][10] = 2;
  grid[6][1] = 2;
  grid[6][10] = 2;

  // Fill remaining paths with dots
  for (int r = 1; r < 7; r++) {
    for (int c = 1; c < 11; c++) {
      if (grid[r][c] == 0) {
        if (!((r == 1 && c == 1) || (r == 1 && c == 10) || (r == 6 && c == 1) || (r == 6 && c == 10))) {
          grid[r][c] = 0; // Dot
        }
      }
    }
  }
}

void pacmanGame() {
  int pacmanLevel = 1;
  int score = 0;

  while (true) {
    uint8_t grid[8][12];
    generatePacmanMaze(grid, pacmanLevel);

    const int dx[] = {0, 1, -1, 0, 0};
    const int dy[] = {0, 0, 0, -1, 1};

    int px = 8;
    int py = 8;
    int pDir = 0;
    int pNextDir = 0;
    const int pSpeed = 2;

    int gx1 = 40, gy1 = 24; // Ghost 1 starts at cell (5,3)
    int gDir1 = 0;
    int gSpeed1 = 2;

    int gx2 = 48, gy2 = 24; // Ghost 2 starts at cell (6,3)
    int gDir2 = 0;
    int gSpeed2 = 2;

    int lives = 3;
    bool scared = false;
    unsigned long scareTimer = 0;

    auto isWall = [&](int gx, int gy) {
      if (gx < 0 || gx >= 12 || gy < 0 || gy >= 8) return true;
      return grid[gy][gx] == 1;
    };

    auto getOppositeDir = [](int d) {
      if (d == 1) return 2;
      if (d == 2) return 1;
      if (d == 3) return 4;
      if (d == 4) return 3;
      return 0;
    };

    auto resetPositions = [&]() {
      px = 8; py = 8; pDir = 0; pNextDir = 0;
      gx1 = 40; gy1 = 24; gDir1 = 0;
      gx2 = 48; gy2 = 24; gDir2 = 0;
    };

    while (digitalRead(OK_BUTTON) == LOW || digitalRead(UP_BUTTON) == LOW) delay(10);

    bool levelPlaying = true;
    bool dotsLeft = true;

    while (levelPlaying && lives > 0) {
      if (digitalRead(RIGHT_BUTTON) == LOW) pNextDir = 1;
      else if (digitalRead(LEFT_BUTTON) == LOW) pNextDir = 2;
      else if (digitalRead(UP_BUTTON) == LOW) pNextDir = 3;
      else if (digitalRead(DOWN_BUTTON) == LOW) pNextDir = 4;

      if (px % 8 == 0 && py % 8 == 0) {
        int cx = px / 8;
        int cy = py / 8;

        if (grid[cy][cx] == 0) {
          grid[cy][cx] = 3;
          score += 10;
        } else if (grid[cy][cx] == 2) {
          grid[cy][cx] = 3;
          score += 50;
          scared = true;
          scareTimer = millis();
        }

        if (pNextDir != 0 && !isWall(cx + dx[pNextDir], cy + dy[pNextDir])) {
          pDir = pNextDir;
        }
        if (pDir != 0 && isWall(cx + dx[pDir], cy + dy[pDir])) {
          pDir = 0;
        }
      }

      if (pDir != 0) {
        px += dx[pDir] * pSpeed;
        py += dy[pDir] * pSpeed;
      }

      if (scared && (millis() - scareTimer > 7000)) {
        scared = false;
      }

      // --- Ghost 1 AI (Blinky: Chaser) ---
      if (gx1 % 8 == 0 && gy1 % 8 == 0) {
        int cx = gx1 / 8;
        int cy = gy1 / 8;
        
        gSpeed1 = scared ? 1 : 2;

        int choices[4];
        int count = 0;
        int opp = getOppositeDir(gDir1);

        for (int d = 1; d <= 4; d++) {
          if (d == opp) continue;
          if (!isWall(cx + dx[d], cy + dy[d])) {
            choices[count++] = d;
          }
        }

        if (count == 0) {
          gDir1 = opp;
        } else {
          int targetX = px / 8;
          int targetY = py / 8;
          int bestDir = choices[0];
          float bestDist = scared ? -1 : 99999;

          for (int i = 0; i < count; i++) {
            int nx = cx + dx[choices[i]];
            int ny = cy + dy[choices[i]];
            float dist = (nx - targetX) * (nx - targetX) + (ny - targetY) * (ny - targetY);

            if (scared) {
              if (dist > bestDist) {
                bestDist = dist;
                bestDir = choices[i];
              }
            } else {
              if (dist < bestDist) {
                bestDist = dist;
                bestDir = choices[i];
              }
            }
          }
          gDir1 = bestDir;
        }
      }

      if (gDir1 != 0) {
        gx1 += dx[gDir1] * gSpeed1;
        gy1 += dy[gDir1] * gSpeed1;
      }

      // --- Ghost 2 AI (Pinky: Random seeking) ---
      if (gx2 % 8 == 0 && gy2 % 8 == 0) {
        int cx = gx2 / 8;
        int cy = gy2 / 8;

        gSpeed2 = scared ? 1 : 2;

        int choices[4];
        int count = 0;
        int opp = getOppositeDir(gDir2);

        for (int d = 1; d <= 4; d++) {
          if (d == opp) continue;
          if (!isWall(cx + dx[d], cy + dy[d])) {
            choices[count++] = d;
          }
        }

        if (count == 0) {
          gDir2 = opp;
        } else {
          gDir2 = choices[random(0, count)];
        }
      }

      if (gDir2 != 0) {
        gx2 += dx[gDir2] * gSpeed2;
        gy2 += dy[gDir2] * gSpeed2;
      }

      // --- Collisions ---
      if (abs(px - gx1) < 6 && abs(py - gy1) < 6) {
        if (scared) {
          gx1 = 40; gy1 = 24; gDir1 = 0;
          score += 200;
        } else {
          lives--;
          resetPositions();
          delay(1000);
          continue;
        }
      }

      if (abs(px - gx2) < 6 && abs(py - gy2) < 6) {
        if (scared) {
          gx2 = 48; gy2 = 24; gDir2 = 0;
          score += 200;
        } else {
          lives--;
          resetPositions();
          delay(1000);
          continue;
        }
      }

      dotsLeft = false;
      for (int r = 0; r < 8; r++) {
        for (int c = 0; c < 12; c++) {
          if (grid[r][c] == 0 || grid[r][c] == 2) {
            dotsLeft = true;
            break;
          }
        }
        if (dotsLeft) break;
      }

      if (!dotsLeft) {
        levelPlaying = false;
      }

      display.clearDisplay();

      // 1. Draw Maze
      for (int r = 0; r < 8; r++) {
        for (int c = 0; c < 12; c++) {
          int tx = c * 8;
          int ty = r * 8;
          if (grid[r][c] == 1) {
            display.fillRect(tx, ty, 8, 8, SSD1306_WHITE);
          } else if (grid[r][c] == 0) {
            display.fillRect(tx + 3, ty + 3, 2, 2, SSD1306_WHITE);
          } else if (grid[r][c] == 2) {
            if ((millis() / 200) % 2 == 0) {
              display.fillRect(tx + 2, ty + 2, 4, 4, SSD1306_WHITE);
            }
          }
        }
      }

      // 2. Draw Pac-Man
      bool mouthOpen = (millis() / 150) % 2;
      if (mouthOpen) {
        const unsigned char* pBmp = pacman_right;
        if (pDir == 2) pBmp = pacman_left;
        else if (pDir == 3) pBmp = pacman_up;
        else if (pDir == 4) pBmp = pacman_down;
        display.drawBitmap(px, py, pBmp, 8, 8, SSD1306_WHITE);
      } else {
        display.fillCircle(px + 4, py + 4, 3, SSD1306_WHITE);
      }

      // 3. Draw Ghosts
      bool drawScared = scared;
      if (scared && (millis() - scareTimer > 5000)) {
        if ((millis() / 150) % 2 == 0) drawScared = false;
      }

      display.drawBitmap(gx1, gy1, drawScared ? ghost_scared : ghost_sprite, 8, 8, SSD1306_WHITE);
      display.drawBitmap(gx2, gy2, drawScared ? ghost_scared : ghost_sprite, 8, 8, SSD1306_WHITE);

      // 4. Draw Right Info Panel
      display.drawFastVLine(96, 0, 64, SSD1306_WHITE);
      display.setTextSize(1);
      display.setCursor(100, 15);
      display.print("L:");
      display.setCursor(100, 25);
      display.print(lives);

      if (scared) {
        display.setCursor(100, 45);
        display.print("PWR");
      }

      display.display();
      delay(25);
    }

    // --- End Screen Selection Menu (Back / Next Level) ---
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(2);
    display.setCursor(10, 5);
    if (dotsLeft) {
      display.print("Game Over!");
    } else {
      display.print("Victory!");
    }

    display.setTextSize(1);
    display.setCursor(15, 25);
    display.print("Score: "); display.print(score);
    display.setCursor(15, 35);
    display.print("Level: "); display.print(pacmanLevel);

    int selection = 0; // 0 = Back, 1 = Next Level
    delay(400);

    while (true) {
      display.fillRect(0, 48, 128, 16, SSD1306_BLACK);
      display.setTextSize(1);
      
      display.setCursor(10, 52);
      if (selection == 0) display.print("> 1. Back");
      else display.print("  1. Back");
      
      display.setCursor(70, 52);
      if (selection == 1) display.print("> 2. Next Lv");
      else display.print("  2. Next Lv");
      
      display.display();
      
      if (digitalRead(LEFT_BUTTON) == LOW || digitalRead(RIGHT_BUTTON) == LOW || 
          digitalRead(UP_BUTTON) == LOW || digitalRead(DOWN_BUTTON) == LOW) {
        selection = 1 - selection;
        delay(200);
      }
      
      if (digitalRead(OK_BUTTON) == LOW) {
        delay(200);
        break;
      }
    }

    if (selection == 0) {
      inGame = false;
      break;
    } else {
      pacmanLevel++;
    }
  }
}
void froggerGame() {
  int frogX = 60;
  int frogY = 56;
  int score = 0;
  int lives = 3;
  int level = 1;

  // 5 Lanes: Y = 48, 40, 32 (road, cars), 24, 16 (river, logs)
  float laneX[5] = {0.0, 30.0, 60.0, 10.0, 40.0};
  const float baseLaneSpeed[5] = {-0.8, 0.6, -1.0, 0.5, -0.7};
  float laneSpeed[5];

  for (int i = 0; i < 5; i++) {
    laneSpeed[i] = baseLaneSpeed[i];
  }

  const int laneY[5] = {48, 40, 32, 24, 16};

  auto drawWrappedBitmap = [](int x, int y, const unsigned char* bmp, int w, int h) {
    int nx = (x % 128 + 128) % 128;
    display.drawBitmap(nx, y, bmp, w, h, SSD1306_WHITE);
    if (nx + w > 128) {
      display.drawBitmap(nx - 128, y, bmp, w, h, SSD1306_WHITE);
    }
  };

  auto drawWrappedLog = [&](int x, int y) {
    drawWrappedBitmap(x, y, log_sprite, 16, 8);
    drawWrappedBitmap(x + 8, y, log_sprite, 16, 8);
  };

  auto checkOverlap = [](int fx, int ox, int ow) {
    int cx = (ox % 128 + 128) % 128;
    if (cx + ow > 128) {
      return (fx + 8 > cx || fx < cx + ow - 128);
    } else {
      return (fx + 8 > cx && fx < cx + ow);
    }
  };

  while (digitalRead(OK_BUTTON) == LOW || digitalRead(UP_BUTTON) == LOW) delay(10);

  while (lives > 0) {
    if (digitalRead(LEFT_BUTTON) == LOW) { frogX -= 8; delay(120); }
    else if (digitalRead(RIGHT_BUTTON) == LOW) { frogX += 8; delay(120); }
    else if (digitalRead(UP_BUTTON) == LOW) { frogY -= 8; delay(120); }
    else if (digitalRead(DOWN_BUTTON) == LOW && frogY < 56) { frogY += 8; delay(120); }

    if (frogX < 0) frogX = 0;
    if (frogX > 120) frogX = 120;

    for (int i = 0; i < 5; i++) {
      laneX[i] += laneSpeed[i];
      if (laneX[i] >= 128.0) laneX[i] -= 128.0;
      if (laneX[i] < 0.0) laneX[i] += 128.0;
    }

    // Check road collisions
    if (frogY == 48 || frogY == 40 || frogY == 32) {
      int laneIdx = (frogY == 48) ? 0 : (frogY == 40) ? 1 : 2;
      int lx = (int)laneX[laneIdx];
      if (checkOverlap(frogX, lx, 8) || checkOverlap(frogX, lx + 64, 8)) {
        lives--;
        frogX = 60; frogY = 56;
        delay(800);
        continue;
      }
    }

    // Check river log alignment
    bool onLog = false;
    float currentLogSpeed = 0.0;
    if (frogY == 24 || frogY == 16) {
      int laneIdx = (frogY == 24) ? 3 : 4;
      int lx = (int)laneX[laneIdx];
      currentLogSpeed = laneSpeed[laneIdx];

      if (checkOverlap(frogX, lx, 24)) {
        onLog = true;
      } else if (checkOverlap(frogX, lx + 64, 24)) {
        onLog = true;
      }

      if (onLog) {
        frogX += currentLogSpeed;
      } else {
        lives--;
        frogX = 60; frogY = 56;
        delay(800);
        continue;
      }
    }

    // Check win bank
    if (frogY <= 8) {
      score += 100;
      level++;
      for (int i = 0; i < 5; i++) {
        laneSpeed[i] = baseLaneSpeed[i] * (1.0 + (level - 1) * 0.15);
      }
      frogX = 60; frogY = 56;
      display.clearDisplay();
      display.setCursor(15, 20);
      display.print("Level "); display.print(level);
      display.display();
      delay(1000);
      continue;
    }

    display.clearDisplay();

    // Draw road stripes
    for (int x = 0; x < 128; x += 16) {
      display.drawFastHLine(x, 48, 8, SSD1306_WHITE);
      display.drawFastHLine(x, 40, 8, SSD1306_WHITE);
      display.drawFastHLine(x, 32, 8, SSD1306_WHITE);
    }
    // Draw river boundaries
    display.drawFastHLine(0, 24, 128, SSD1306_WHITE);
    display.drawFastHLine(0, 16, 128, SSD1306_WHITE);

    // Draw obstacles
    for (int i = 0; i < 5; i++) {
      int lx = (int)laneX[i];
      if (i < 3) {
        drawWrappedBitmap(lx, laneY[i], car_sprite, 8, 8);
        drawWrappedBitmap(lx + 64, laneY[i], car_sprite, 8, 8);
      } else {
        drawWrappedLog(lx, laneY[i]);
        drawWrappedLog(lx + 64, laneY[i]);
      }
    }

    display.drawBitmap(frogX, (int)frogY, frog_sprite, 8, 8, SSD1306_WHITE);

    display.drawFastHLine(0, 55, 128, SSD1306_WHITE);
    display.drawFastHLine(0, 7, 128, SSD1306_WHITE);

    display.setTextSize(1);

    display.setCursor(45, 0);
    display.print("Lv:"); display.print(level);
    display.setCursor(95, 0);
    display.print("L:"); display.print(lives);

    display.display();
    delay(20);
  }

  gameOver(score);
  inGame = false;
}
// ===================== GAME 16: HELICOPTER =====================
void helicopterGame() {
  float copterY = 32;
  float copterVY = 0;
  const float gravity = 0.35;
  const float lift = -0.7;

  int roof[16];
  int floor[16];
  for (int i=0; i<16; i++) {
    roof[i] = random(4, 15);
    floor[i] = random(48, 58);
  }

  int obsX = SCREEN_WIDTH;
  int obsY = 25;
  int obsHeight = 15;

  int score = 0;
  bool playing = true;
  float segmentOffset = 0;
  float gameSpeed = 2.0;

  while (playing) {
    bool fly = (digitalRead(OK_BUTTON) == LOW || digitalRead(UP_BUTTON) == LOW);
    if (fly) {
      copterVY += lift;
    } else {
      copterVY += gravity;
    }

    copterVY = constrain(copterVY, -4.0, 4.0);
    copterY += copterVY;

    segmentOffset += gameSpeed;
    if (segmentOffset >= 8.0) {
      segmentOffset = 0;
      for (int i=0; i<15; i++) {
        roof[i] = roof[i+1];
        floor[i] = floor[i+1];
      }
      roof[15] = random(4, 15);
      floor[15] = random(48, 58);
      score++;
    }

    obsX -= gameSpeed;
    if (obsX < -8) {
      obsX = SCREEN_WIDTH + random(20, 80);
      obsY = random(16, 40);
      obsHeight = random(10, 20);
    }

    int segIdx = (20 + (int)segmentOffset) / 8;
    if (copterY < roof[segIdx] || copterY + 6 > floor[segIdx]) {
      playing = false; 
    }

    if (obsX < 28 && obsX + 8 > 20) {
      if (copterY < obsY + obsHeight && copterY + 6 > obsY) {
        playing = false; 
      }
    }

    display.clearDisplay();

    for (int i=0; i<16; i++) {
      int tx = i * 8 - (int)segmentOffset;
      display.fillRect(tx, 0, 8, roof[i], SSD1306_WHITE);
      display.fillRect(tx, floor[i], 8, SCREEN_HEIGHT - floor[i], SSD1306_WHITE);
    }

    display.fillRect((int)obsX, obsY, 8, obsHeight, SSD1306_WHITE);

    int cy = (int)copterY;
    display.fillRect(20, cy + 2, 8, 3, SSD1306_WHITE); 
    display.drawLine(18, cy + 1, 23, cy + 1, SSD1306_WHITE); 
    display.drawLine(20, cy + 5, 26, cy + 5, SSD1306_WHITE); 



    display.display();
    delay(20);
  }

  gameOver(score);
  inGame = false;
}
